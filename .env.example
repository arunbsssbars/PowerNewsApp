# =============================================================================
# PowerNews - Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace placeholders with your actual secrets.
# =============================================================================

# Server Port
PORT=3000
SERVER_PORT=3000

# Client App Authorization Secret (Sent via 'x-api-key' header)
APP_CLIENT_SECRET=your_shared_secret_key_here

# CORS Allowed Origins for Web Clients (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-domain.com

# Health Probe & Timeout
API_HEALTH_PATH=/api/health
API_TIMEOUT_SECONDS=4

# App Environment & Debugging
APP_ENV=production
DEBUG_LOGGING=true

# Retention & Pagination
ARTICLE_RETENTION_DAYS=7
PAGE_SIZE=25

# Background Refresh & Media Settings
AUTO_REFRESH_INTERVAL_MINUTES=2
BGM_VOLUME=0.12
DIGEST_MAX_ARTICLES=20

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
