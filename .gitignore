# -----------------------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.key
*.pem
*.keystore
*.jks
*serviceAccountKey*.json
*service-account*.json
firebase-adminsdk*.json

# -----------------------------------------------------------------------------
# Node.js & Backend
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Runtime caches & data (persisted in Cloud Firestore)
ai-summaries-cache.json
server/.server_lifecycle.json
server/data/*.json
!server/data/.gitkeep

# -----------------------------------------------------------------------------
# Flutter & Dart
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

